# Copy to .env. Replace this development placeholder before starting Compose.
# Generate a strong value, for example: openssl rand -base64 48
JWT_SECRET=asd789213esakldd931dbbd1fdc40b18b2925c67a8b7069436ed5878689480fb71682e4716f11f0

# These values must match in User, Gateway, Product, and Media services.
JWT_ISSUER=user-service
JWT_AUDIENCE=buy-01-api

# Comma-separated exact development origins; omit URL paths and trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Required only with docker-compose.prod.yml. It must match the certificate path
# /etc/letsencrypt/live/${SERVER_NAME}/ on the deployment host.
SERVER_NAME=buy01.example.com
